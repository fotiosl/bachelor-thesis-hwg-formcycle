{
  "name": "Synthetic Compliant Form (Ground Truth 100%)",
  "description": "Synthetisches Referenzformular der HWG Ludwigshafen, das alle 22 Governance-Regeln der Compliance-Registry v1.5.0 strikt einhält.",
  "properties": {
    "maxwidth": "850px",
    "minwidth": "300px"
  },
  "items": [
    {
      "className": "XHeader",
      "properties": {
        "name": "header1",
        "id": "xi-header-1",
        "maxwidth": "850px",
        "minwidth": "300px",
        "showrequiredhint": "1"
      }
    },
    {
      "className": "XHeading",
      "properties": {
        "name": "txtFormTitle",
        "parentid": "xi-header-1",
        "headinglevel": "1",
        "heading": "Antrag auf Sondergenehmigung",
        "rtevalue": "<h1>Antrag auf Sondergenehmigung</h1>"
      }
    },
    {
      "className": "XImage",
      "properties": {
        "name": "imgHWGLogo",
        "parentid": "xi-header-1",
        "alt": "Offizielles Logo der Hochschule für Wirtschaft und Gesellschaft Ludwigshafen",
        "imageheight": "60",
        "textalign": "right",
        "url": "https://www.hwg-lu.de/typo3conf/ext/hwg_sitepackage/Resources/Public/Images/logo.svg"
      }
    },
    {
      "className": "XPage",
      "properties": {
        "name": "p1",
        "id": "xi-page-1",
        "maxwidth": "850px",
        "minwidth": "300px"
      }
    },
    {
      "className": "XFieldSet",
      "properties": {
        "name": "fsPersoenlicheAngaben",
        "id": "xi-fs-pers",
        "parentid": "xi-page-1",
        "label": "<p>Pers&ouml;nliche Angaben</p>",
        "legend": "Persönliche Angaben",
        "maxwidth": "850px"
      }
    },
    {
      "className": "XSelect",
      "properties": {
        "name": "selAnrede",
        "parentid": "xi-fs-pers",
        "label": "<p>Anrede</p>",
        "required": "1"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfVorname",
        "parentid": "xi-fs-pers",
        "label": "<p>Vorname</p>",
        "required": "1"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfNachname",
        "parentid": "xi-fs-pers",
        "label": "<p>Nachname</p>",
        "required": "1"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfEmail",
        "parentid": "xi-fs-pers",
        "label": "<p>E-Mail-Adresse</p>",
        "required": "1",
        "datatype": "email",
        "validation": { "type": "email" }
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfTelefon",
        "parentid": "xi-fs-pers",
        "label": "<p>Telefonnummer</p>",
        "datatype": "regexp",
        "vrule": "^(\\+[0-9]{1,3}|0)[0-9\\s\\-/]{6,20}$"
      }
    },
    {
      "className": "XFieldSet",
      "properties": {
        "name": "fsAnschriftBank",
        "id": "xi-fs-bank",
        "parentid": "xi-page-1",
        "label": "<p>Anschrift und Bankverbindung</p>",
        "legend": "Anschrift und Bankverbindung",
        "maxwidth": "850px"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfPLZ",
        "parentid": "xi-fs-bank",
        "rowid": "row-plz-ort",
        "computedwidth": "30%",
        "maxwidth": "120px",
        "label": "<p>Postleitzahl</p>",
        "datatype": "plzDE",
        "pattern": "^[0-9]{5}$",
        "validation": { "regex": "^[0-9]{5}$" },
        "required": "1"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfOrt",
        "parentid": "xi-fs-bank",
        "rowid": "row-plz-ort",
        "computedwidth": "70%",
        "label": "<p>Wohnort</p>",
        "required": "1"
      }
    },
    {
      "className": "XTextField",
      "properties": {
        "name": "tfIBAN",
        "parentid": "xi-fs-bank",
        "label": "<p>IBAN</p>",
        "datatype": "regexp",
        "vrule": "^[A-Z]{2}[0-9]{2}(?:\\s?[0-9]{4}){4}\\s?[0-9]{2}$",
        "pattern": "^[A-Z]{2}[0-9]{2}(?:\\s?[0-9]{4}){4}\\s?[0-9]{2}$",
        "validation": { "regex": "^[A-Z]{2}[0-9]{2}(?:\\s?[0-9]{4}){4}\\s?[0-9]{2}$", "type": "iban" },
        "required": "1"
      }
    },
    {
      "className": "XUpload",
      "properties": {
        "name": "uplNachweise",
        "parentid": "xi-fs-bank",
        "label": "<p>Nachweisbelege hochladen</p>",
        "fileextension": ".pdf,.jpg,.png",
        "maxfilesize": "10240",
        "helptext": "Erlaubte Dateiformate: PDF, JPG, PNG. Maximale Dateigröße: max. 10 MB pro Datei.",
        "help": "Erlaubte Dateiformate: PDF, JPG, PNG. Maximale Dateigröße: max. 10 MB pro Datei."
      }
    },
    {
      "className": "XFieldSet",
      "properties": {
        "name": "fsDatenschutzAblauf",
        "id": "xi-fs-dsgvo",
        "parentid": "xi-page-1",
        "label": "<p>Datenschutz und Verfahrensablauf</p>",
        "legend": "Datenschutz und Verfahrensablauf",
        "maxwidth": "850px"
      }
    },
    {
      "className": "XText",
      "properties": {
        "name": "txtDatenschutzHinweis",
        "parentid": "xi-fs-dsgvo",
        "text": "Informationen zur Datenverarbeitung: Ihre personenbezogenen Daten werden gemäß Art. 13 DSGVO vertraulich verarbeitet. Ausführliche Informationen finden Sie in der Datenschutzerklärung der HWG Ludwigshafen unter https://www.hwg-lu.de/datenschutz.",
        "rtevalue": "<p>Informationen zur Datenverarbeitung: Ihre personenbezogenen Daten werden gem&auml;&szlig; Art. 13 DSGVO vertraulich verarbeitet. Ausf&uuml;hrliche Informationen finden Sie in der <a href=\"https://www.hwg-lu.de/datenschutz\">Datenschutzerkl&auml;rung der HWG Ludwigshafen</a>.</p>"
      }
    },
    {
      "className": "XText",
      "properties": {
        "name": "txtVerfahrensablauf",
        "parentid": "xi-fs-dsgvo",
        "text": "Weiterer Ablauf: Nach dem Absenden wird Ihr Antrag geprüft. Die reguläre Bearbeitungsdauer beträgt ca. 10 Werktage. Sie erhalten den schriftlichen Bescheid per E-Mail."
      }
    },
    {
      "className": "XButton",
      "properties": {
        "name": "btnSubmit",
        "parentid": "xi-page-1",
        "text": "Antrag einreichen",
        "type": "submit"
      }
    },
    {
      "className": "XFooter",
      "properties": {
        "name": "footer1",
        "maxwidth": "850px",
        "minwidth": "300px",
        "showlogo": "0",
        "showrequiredhint": "1",
        "privacyPolicyShow": "1"
      }
    }
  ],
  "workflow_emails": [
    {
      "node_name": "E-Mail Eingangsbestätigung an Antragstellende",
      "recipient": "[%$tfEmail%]",
      "subject": "Eingangsbestätigung Ihres Antrags (Vorgangsnummer [%$PROJECT_ALIAS%])",
      "body": "Vielen Dank für Ihren Antrag (Vorgangsnummer [%$PROJECT_ALIAS%]). Ihr Antrag ist eingegangen und wird nun durch das Studierendensekretariat der HWG Ludwigshafen geprüft. Über die weiteren Prozessschritte und die Entscheidung werden Sie per E-Mail informiert."
    }
  ],
  "workflow_states": [
    "Eingegangen",
    "In Prüfung",
    "Genehmigt",
    "Abgelehnt",
    "Archiviert"
  ]
}
